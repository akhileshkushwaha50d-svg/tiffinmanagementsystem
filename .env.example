# Environment Configuration for Express + Prisma Tiffin Management Backend

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=tiffin_super_secure_jwt_secret_key_2026_production

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection URL (PostgreSQL / Supabase / Neon / Local Docker)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiffin_db?schema=public
