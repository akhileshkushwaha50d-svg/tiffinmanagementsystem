# =================================================================
# Production Environment Variables Example
# =================================================================

# Server Port (Cloud providers like Render/Railway automatically assign PORT)
PORT=5000

# Node Environment
NODE_ENV=production

# JSON Web Token Secret (Use a strong random 64-character string)
JWT_SECRET=super_strong_production_random_secret_token_at_least_32_chars_2026

# Allowed Frontend Client URL for CORS (* for public, or your custom domain)
CLIENT_URL=*

# PostgreSQL Database Connection URL (from Render, Supabase, Neon, or Railway)
# Example Supabase / Neon: postgresql://postgres:mypassword@db.xxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
