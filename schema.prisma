generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  OWNER
  SUPER_ADMIN
}

enum ProviderStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum MenuStatus {
  DRAFT
  PUBLISHED
}

enum DeliveryStatus {
  ORDER_RECEIVED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  STOPPED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile StudentProfile?
  ownedProvider  TiffinProvider?
  notifications  Notification[]
  auditLogs      AuditLog[]
}

model TiffinProvider {
  id                String         @id @default(cuid())
  ownerId           String         @unique
  owner             User           @relation(fields: [ownerId], references: [id])
  businessName      String
  address           String
  contactPhone      String
  status            ProviderStatus @default(PENDING)
  breakfastCutoff   String         @default("08:00") // HH:mm IST
  lunchCutoff       String         @default("10:00")
  dinnerCutoff      String         @default("18:00")
  stopLeadHours     Int            @default(2)
  createdAt         DateTime       @default(now())

  subscriptions   Subscription[]
  menus           Menu[]
  deliveries      Delivery[]
  inventory       InventoryItem[]
  expenses        Expense[]
  suggestions     FoodSuggestion[]
  complaints      Complaint[]
  staff           Staff[]

  @@index([status])
}

model StudentProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  address             String
  walletBalance       Decimal  @default(0.00) @db.Decimal(10, 2)
  referralCode        String   @unique
  referredBy          String?
  rewardPoints        Int      @default(0)
  isJain              Boolean  @default(false)
  lessSpicy           Boolean  @default(false)
  noOnionGarlic       Boolean  @default(false)
  allergies           String?
  specialInstructions String?
  boxesHeld           Int      @default(0) // Physical tiffin container tracking

  subscriptions      Subscription[]
  stopMealRequests   StopMealRequest[]
  deliveries         Delivery[]
  walletTransactions WalletTransaction[]
  payments           Payment[]
  feedbacks          Feedback[]
  complaints         Complaint[]
  votes              Vote[]
}

model Subscription {
  id                String             @id @default(cuid())
  studentId         String
  student           StudentProfile     @relation(fields: [studentId], references: [id])
  providerId        String
  provider          TiffinProvider     @relation(fields: [providerId], references: [id])
  planType          String             // DAILY, WEEKLY, MONTHLY, CUSTOM
  includesBreakfast Boolean            @default(false)
  includesLunch     Boolean            @default(true)
  includesDinner    Boolean            @default(true)
  startDate         DateTime
  endDate           DateTime
  totalPrice        Decimal            @db.Decimal(10, 2)
  status            SubscriptionStatus @default(ACTIVE)
  createdAt         DateTime           @default(now())

  @@index([studentId, status])
  @@index([providerId, status])
}

model Menu {
  id          String         @id @default(cuid())
  providerId  String
  provider    TiffinProvider @relation(fields: [providerId], references: [id])
  menuDate    DateTime       @db.Date
  mealType    MealType
  status      MenuStatus     @default(DRAFT)
  mealTiming  String         // e.g. "12:30 PM - 2:00 PM"
  isSpecial   Boolean        @default(false)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items MenuItem[]

  @@unique([providerId, menuDate, mealType])
  @@index([providerId, status, menuDate])
}

model MenuItem {
  id          String  @id @default(cuid())
  menuId      String
  menu        Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  isAvailable Boolean @default(true)
}

model StopMealRequest {
  id         String         @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id])
  providerId String
  mealDate   DateTime       @db.Date
  mealType   MealType
  reason     String?
  isResumed  Boolean        @default(false)
  creditAmt  Decimal        @default(0.00) @db.Decimal(10, 2)
  createdAt  DateTime       @default(now())

  @@unique([studentId, mealDate, mealType])
  @@index([providerId, mealDate])
}

model Delivery {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  providerId  String
  provider    TiffinProvider @relation(fields: [providerId], references: [id])
  mealDate    DateTime       @db.Date
  mealType    MealType
  status      DeliveryStatus @default(ORDER_RECEIVED)
  qrToken     String         @unique @default(cuid())
  deliveredAt DateTime?
  address     String
  updatedAt   DateTime       @updatedAt

  @@unique([studentId, mealDate, mealType])
  @@index([providerId, mealDate, status])
}

model Payment {
  id                String         @id @default(cuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id])
  providerId        String?
  amount            Decimal        @db.Decimal(10, 2)
  gatewayOrderId    String         @unique
  gatewayPaymentId  String?        @unique
  status            PaymentStatus  @default(PENDING)
  purpose           String         // WALLET_RECHARGE, SUBSCRIPTION
  createdAt         DateTime       @default(now())
  verifiedAt        DateTime?
}

model WalletTransaction {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  type        String         // CREDIT, DEBIT, REFUND
  amount      Decimal        @db.Decimal(10, 2)
  description String
  referenceId String?
  createdAt   DateTime       @default(now())
}

model Feedback {
  id              String         @id @default(cuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id])
  providerId      String
  mealDate        DateTime       @db.Date
  mealType        MealType
  overallVerdict  String         // Excellent, Good, Average, Not Good
  tasteRating     Int
  qualityRating   Int
  quantityRating  Int
  hygieneRating   Int
  comment         String?
  ownerResponse   String?
  createdAt       DateTime       @default(now())
}

model FoodSuggestion {
  id         String         @id @default(cuid())
  providerId String
  provider   TiffinProvider @relation(fields: [providerId], references: [id])
  dishName   String
  status     String         @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt  DateTime       @default(now())
  votes      Vote[]
}

model Vote {
  id           String         @id @default(cuid())
  suggestionId String
  suggestion   FoodSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id])

  @@unique([suggestionId, studentId])
}

model Complaint {
  id          String          @id @default(cuid())
  studentId   String
  student     StudentProfile  @relation(fields: [studentId], references: [id])
  providerId  String
  provider    TiffinProvider  @relation(fields: [providerId], references: [id])
  category    String          // Quality, Delivery Delay, Payment, Incorrect Order
  description String
  status      ComplaintStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime        @default(now())
}

model InventoryItem {
  id           String         @id @default(cuid())
  providerId   String
  provider     TiffinProvider @relation(fields: [providerId], references: [id])
  itemName     String
  quantity     Decimal        @db.Decimal(10, 2)
  unit         String         // kg, L, cylinders
  minThreshold Decimal        @db.Decimal(10, 2)
  supplierName String?
  updatedAt    DateTime       @updatedAt
}

model Expense {
  id          String         @id @default(cuid())
  providerId  String
  provider    TiffinProvider @relation(fields: [providerId], references: [id])
  category    String         // Raw Materials, Staff, Gas, Electricity, Rent
  amount      Decimal        @db.Decimal(10, 2)
  expenseDate DateTime       @db.Date
  notes       String?
  createdAt   DateTime       @default(now())
}

model Staff {
  id         String         @id @default(cuid())
  providerId String
  provider   TiffinProvider @relation(fields: [providerId], references: [id])
  name       String
  role       String         // COOK, HELPER, DELIVERY
  phone      String
  salary     Decimal        @db.Decimal(10, 2)
  isActive   Boolean        @default(true)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}
