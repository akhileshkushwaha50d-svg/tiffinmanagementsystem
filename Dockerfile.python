# =================================================================
# Production Dockerfile for Python 3 Standard Library Stack
# Zero Pip Dependencies + SQLite Relational Database + Frontend SPA
# =================================================================

FROM python:3.11-slim

WORKDIR /app

# Set environment
ENV PYTHONUNBUFFERED=1
ENV PORT=5000

# Copy application files
COPY server.py ./
COPY database.py ./
COPY index.html ./
COPY static ./static/

# Create persistent database directory
RUN mkdir -p /app/data

# Expose port
EXPOSE 5000

# Run Python server
CMD ["python", "server.py", "--port", "5000"]
